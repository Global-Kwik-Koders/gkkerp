{
  "name": "gkkerp",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/api & npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "npm run migrate --workspace=apps/api",
